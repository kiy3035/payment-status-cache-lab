# 이 파일을 .env로 복사하고 비밀번호 예시를 로컬 전용 값으로 변경한다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=payment_lab
MYSQL_USER=payment_app
MYSQL_PASSWORD=replace-with-local-only-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-only-root-password

REDIS_HOST=localhost
REDIS_PORT=6379

PAYMENT_STATUS_CACHE_ENABLED=false
PAYMENT_STATUS_CACHE_KEY_PREFIX=payment:status:
PAYMENT_STATUS_CACHE_TTL=5m
PAYMENT_STATUS_CACHE_COMMAND_TIMEOUT=100ms
PAYMENT_STATUS_CACHE_CONNECT_TIMEOUT=100ms

SERVER_PORT=8080
